{
  "name": "lumix-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-blux-spot.cjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint:spot": "eslint components/spot-*.ts components/spot-*.tsx components/blux-runtime.tsx components/wallet-provider.tsx app/spot scripts/*.cjs",
    "test:spot": "node --test tests/spot-model.test.cjs tests/spot-transaction.test.cjs",
    "test:spot:browser": "playwright test --config=playwright.spot.config.cjs",
    "test:spot:testnet": "node scripts/verify-spot-testnet.cjs",
    "lint:earn": "eslint components/earn-*.ts components/earn-*.tsx components/app-routes.ts app/earn",
    "test": "node --test tests/*.test.cjs",
    "test:earn": "node --test tests/earn-model.test.cjs tests/earn-detail-model.test.cjs",
    "test:earn:browser": "playwright test --config=playwright.earn.config.cjs",
    "test:portfolio": "node --test tests/portfolio-records.test.cjs"
  },
  "dependencies": {
    "@bluxcc/react": "0.3.7",
    "@fontsource-variable/inter": "5.3.0",
    "@stellar/stellar-sdk": "17.1.0",
    "@tanstack/react-query": "5.103.1",
    "lightweight-charts": "5.2.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "@bluxcc/core": "0.3.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  }
}
